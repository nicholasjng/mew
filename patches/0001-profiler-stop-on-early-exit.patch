diff --git a/include/benchmark/benchmark_api.h b/include/benchmark/benchmark_api.h
index d7ba187..7eca648 100644
--- a/include/benchmark/benchmark_api.h
+++ b/include/benchmark/benchmark_api.h
@@ -267,6 +267,7 @@ class Fixture : public Benchmark {
   void Run(State& st) override {
     this->SetUp(st);
     this->BenchmarkCase(st);
+    st.FinishBenchmarkBody();
     this->TearDown(st);
   }
   virtual void SetUp(const State&) {}
diff --git a/include/benchmark/state.h b/include/benchmark/state.h
index c0837d8..7921d3d 100644
--- a/include/benchmark/state.h
+++ b/include/benchmark/state.h
@@ -181,6 +181,9 @@ class BENCHMARK_EXPORT BENCHMARK_INTERNAL_CACHELINE_ALIGNED State {
   inline bool KeepRunningInternal(IterationCount n, bool is_batch);
   void FinishKeepRunning();
 
+  // Also called when a benchmark body returns without exhausting its loop.
+  void FinishBenchmarkBody();
+
   // The checked entry points above forward here; keeping the bodies out of
   // line keeps the assertions with the caller, whose NDEBUG decides whether
   // they are compiled in.
@@ -196,6 +199,9 @@ class BENCHMARK_EXPORT BENCHMARK_INTERNAL_CACHELINE_ALIGNED State {
   internal::PerfCountersMeasurement* const perf_counters_measurement_;
   ProfilerManager* const profiler_manager_;
 
+  bool profiler_active_ = false;
+
+  friend class Fixture;
   friend class internal::BenchmarkInstance;
 };
 
diff --git a/src/benchmark.cc b/src/benchmark.cc
index e49cbdc..a23506b 100644
--- a/src/benchmark.cc
+++ b/src/benchmark.cc
@@ -308,6 +308,7 @@ void State::StartKeepRunning() {
   started_ = true;
   total_iterations_ = skipped() ? 0 : max_iterations;
   if (BENCHMARK_BUILTIN_EXPECT(profiler_manager_ != nullptr, false)) {
+    profiler_active_ = true;
     profiler_manager_->AfterSetupStartWithState(*this);
   }
   manager_->StartStopBarrier();
@@ -317,7 +318,9 @@ void State::StartKeepRunning() {
 }
 
 void State::FinishKeepRunning() {
-  BM_CHECK(started_ && (!finished_ || skipped()));
+  BM_CHECK(started_);
+  // A second request for iterations must not stop timing or profiling again.
+  if (finished_) return;
   if (!skipped()) {
     PauseTiming();
   }
@@ -325,7 +328,12 @@ void State::FinishKeepRunning() {
   total_iterations_ = 0;
   finished_ = true;
   manager_->StartStopBarrier();
-  if (BENCHMARK_BUILTIN_EXPECT(profiler_manager_ != nullptr, false)) {
+  FinishBenchmarkBody();
+}
+
+void State::FinishBenchmarkBody() {
+  if (profiler_active_) {
+    profiler_active_ = false;
     profiler_manager_->BeforeTeardownStopWithState(*this);
   }
 }
diff --git a/src/benchmark_api_internal.cc b/src/benchmark_api_internal.cc
