+  const bool manager_pass = manager_->IsManagerPass();
+  if (manager_pass) {
+    if (manager_pass_finished_) return;
+    manager_pass_finished_ = true;
+    if (!started_) {
+      // A body that returned before the loop still takes part in the two
+      // entry barriers of StartKeepRunning().
+      manager_->ManagerPassBarrier();
+      manager_->ManagerPassBarrier();
+    }
+    // Every body reaches this path before fixture teardown, even on a skip.
+    manager_->ManagerPassBarrier();
+  }
