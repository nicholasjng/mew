 class ProfilerManager {
  public:
+  // Summary a profiler reports back for the profiled run, stamped onto the
+  // `Run` by the runner. Free-form so a manager can carry whatever its backend
+  // measures: `values` for numeric figures, `labels` for textual ones (e.g. the
+  // hottest frame). Both empty means "this manager reports no summary".
+  struct Result {
+    std::map<std::string, double> values;
+    std::map<std::string, std::string> labels;
+  };
+
   virtual ~ProfilerManager() {}
   virtual void AfterSetupStart() = 0;
   virtual void BeforeTeardownStop() = 0;
+  // Not pure: a manager that only brackets an external profiler and reports
+  // nothing back keeps compiling unchanged.
+  virtual void GetResult(Result& result) { (void)result; }
 };
 
