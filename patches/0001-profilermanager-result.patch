+// Scopes a MemoryManager to the timing loop instead of the whole body. GB's
+// StartKeepRunning / FinishKeepRunning hooks fire after fixture construction and
+// at loop exit, so allocations made building a fixture stay out of the
+// measurement -- the same region a ProfilerManager sees, and the only one whose
+// figures are comparable across benchmarks with different setup costs.
+class MemoryLoopScope : public ProfilerManager {
+ public:
+  explicit MemoryLoopScope(MemoryManager* mm) : mm_(mm) {}
+
+  void AfterSetupStart() override {
+    started = true;
+    mm_->Start();
+  }
+  void BeforeTeardownStop() override {
+    if (!started || stopped) return;
+    stopped = true;
+    mm_->Stop(result);
+  }
+
+  // Close a manager left open by a body that raised mid-loop, so the next
+  // benchmark can start a fresh capture. The figures are discarded.
+  void CloseIfDangling() {
+    if (started && !stopped) {
+      stopped = true;
+      MemoryManager::Result discard;
+      mm_->Stop(discard);
+      started = false;
+    }
+  }
+
+  MemoryManager::Result result;
+  bool started = false;
+  bool stopped = false;
+
+ private:
+  MemoryManager* mm_;
+};
